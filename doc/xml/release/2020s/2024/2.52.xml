<release date="2024-05-27" version="2.52" title="PostgreSQL 17beta1 Support">
    <release-core-list>
        <text>
            <p><b>NOTE TO PACKAGERS</b>: The build system for <backrest/> is now <proper>meson</proper>. The <proper>autoconf</proper>/<proper>make</proper> build will not receive any new features and will be removed after a few releases.</p>
        </text>

        <release-feature-list>
            <release-item>
                <github-pull-request id="2326"/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                    <release-item-reviewer id="reid.thompson"/>
                </release-item-contributor-list>

                <p>Add <proper>GCS</proper> batch delete support.</p>

                <p>Files are removed with batch requests instead of one request per file, which speeds up <cmd>expire</cmd> and other commands that remove files from the repository.</p>
            </release-item>

            <release-item>
                <github-issue id="2279"/>
                <github-pull-request id="2282"/>

                <release-item-contributor-list>
                    <release-item-ideator id="tim.jones"/>
                    <release-item-contributor id="david.steele"/>
                    <release-item-reviewer id="tim.jones"/>
                </release-item-contributor-list>

                <p><proper>S3</proper> <id>SSE-C</id> encryption support.</p>

                <p>Set <setting>repo-s3-sse-customer-key</setting> to have <proper>S3</proper> encrypt the data with the provided key after it is transmitted. This is not as secure as encrypting the data before it is transmitted with <setting>repo-cipher-type</setting>.</p>
            </release-item>

            <release-item>
                <commit subject="PostgreSQL 17 Support.">
                    <github-pull-request id="2328"/>
                </commit>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                    <release-item-reviewer id="stefan.fercot"/>
                </release-item-contributor-list>

                <p><proper>PostgreSQL</proper> 17beta1 support.</p>

                <p>Adds the catalog version and WAL magic number for <postgres/> 17.</p>
            </release-item>
        </release-feature-list>

        <release-improvement-list>
            <release-item>
                <github-pull-request id="2321"/>

                <release-item-contributor-list>
                    <release-item-contributor id="michael.schout"/>
                    <release-item-reviewer id="david.steele"/>
                </release-item-contributor-list>

                <p>Allow explicit disabling of optional dependencies in meson builds.</p>

                <p>An optional feature can be disabled in the <proper>meson</proper> build even when its library is installed, as some platforms require, e.g. <proper>FreeBSD</proper>. By default a feature is enabled when its library is found.</p>
            </release-item>

            <release-item>
                <commit subject="Update meson minimum version to 0.47."/>
                <commit subject="Dynamically find python in meson build.">
                    <github-pull-request id="2338"/>
                </commit>

                <release-item-contributor-list>
                    <release-item-contributor id="michael.schout"/>
                    <release-item-reviewer id="david.steele"/>
                </release-item-contributor-list>

                <p>Dynamically find <proper>python</proper> in <proper>meson</proper> build.</p>

                <p>The <proper>meson</proper> build now finds the <proper>python</proper> installation instead of requiring a <file>python3</file> binary on the path, e.g. when only <file>python3.9</file> is installed. The minimum <proper>meson</proper> version is now 0.47.</p>
            </release-item>

            <release-item>
                <github-pull-request id="2312"/>

                <release-item-contributor-list>
                    <release-item-contributor id="bradford.boyle"/>
                    <release-item-reviewer id="david.steele"/>
                </release-item-contributor-list>

                <p>Tag <id>pgbackrest</id> build target in meson as installable.</p>
            </release-item>
        </release-improvement-list>

        <release-development-list>
            <release-item>
                <github-pull-request id="2337"/>

                <release-item-contributor-list>
                    <release-item-contributor id="reid.thompson"/>
                    <release-item-reviewer id="david.steele"/>
                </release-item-contributor-list>

                <p>Update Fedora test image to Fedora 38.</p>
            </release-item>

            <release-item>
                <commit subject="Update command module to recent coding standards."/>
                <commit subject="Update common module to recent coding standards."/>
                <commit subject="Update config module to recent coding standards."/>
                <commit subject="Update db/postgres modules to recent coding standards."/>
                <commit subject="Update info module to recent coding standards."/>
                <commit subject="Update storage (except remote) module to recent coding standards."/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Update modules to recent coding standards.</p>
            </release-item>

            <release-item>
                <commit subject="Remove ASSERT() in sckClientOpen() to silence Coverity complaint."/>
