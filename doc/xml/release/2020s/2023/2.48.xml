        </release-bug-list>

        <release-development-list>
            <release-item>
                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Split release notes into individual files.</p>
            </release-item>

            <release-item>
