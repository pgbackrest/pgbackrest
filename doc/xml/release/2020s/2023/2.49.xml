<release date="2023-11-27" version="2.49" title="Remove PostgreSQL 9.3 Support">
    <release-core-list>
        <release-bug-list>
            <release-item>
                <commit subject="Remove unused header."/>
                <commit subject="Fix regression in retries.">
                    <github-issue id="2200"/>
                    <github-issue id="2214"/>
                    <github-pull-request id="2221"/>
                </commit>

                <release-item-contributor-list>
                    <release-item-ideator id="norman.adkins"/>
                    <release-item-ideator id="tanel.suurhans"/>
                    <release-item-ideator id="jordan.english"/>
                    <release-item-ideator id="timothee.peignier"/>
                    <release-item-contributor id="david.steele"/>
                    <release-item-reviewer id="stephen.frost"/>
                </release-item-contributor-list>

                <p>Fix regression in retries.</p>

                <p>v2.48 dropped the retry that was made when an operation used up its whole timeout, so a timeout became an error, e.g. waiting for a socket to be writable on an object store. Two retries are now made even when the timeout has expired.</p>
            </release-item>

            <release-item>
                <github-issue id="2219"/>
                <github-pull-request id="2226"/>

                <release-item-contributor-list>
                    <release-item-ideator id="luc.languagetools"/>
                    <release-item-contributor id="reid.thompson"/>
                    <release-item-reviewer id="stephen.frost"/>
                </release-item-contributor-list>

                <p>Fix recursive path remove in <proper>SFTP</proper> storage driver.</p>

                <p>Some <proper>SFTP</proper> servers report permission denied instead of a failure when a directory is unlinked as a file, so removing a path recursively failed on those servers.</p>
            </release-item>
        </release-bug-list>

        <release-improvement-list>
            <release-item>
                <github-pull-request id="2220"/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                    <release-item-reviewer id="stephen.frost"/>
                </release-item-contributor-list>

                <p>Remove support for <proper>PostgreSQL</proper> <id>9.3</id>.</p>

                <p><postgres/> 9.3 is no longer supported, per the policy of supporting five end-of-life versions of <postgres/>.</p>
            </release-item>
        </release-improvement-list>

        <release-development-list>
            <release-item>
                <github-pull-request id="2224"/>

                <release-item-contributor-list>
                    <release-item-contributor id="georgy.shelkovy"/>
                    <release-item-reviewer id="david.steele"/>
                </release-item-contributor-list>

                <p>Fix <code>storageReadRemote()</code> to return actual read bytes.</p>
            </release-item>

            <release-item>
                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Update config.guess and config.sub to latest versions.</p>
            </release-item>

            <release-item>
                <commit subject="More efficient/compact calculations for encoded sizes."/>
                <commit subject="Remove unused parameter in backupProcess()."/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Clean up code.</p>
            </release-item>
        </release-development-list>
    </release-core-list>

    <release-doc-list>
        <release-feature-list>
            <release-item>
                <github-pull-request id="2202"/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                    <release-item-reviewer id="stefan.fercot"/>
                </release-item-contributor-list>

                <p>Document maintainer options.</p>

                <p>Maintainer options are now documented in their own section with the caveats for using them, and <setting>pg-version-force</setting> is no longer internal.</p>
            </release-item>

            <release-item>
                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Update point-in-time recovery documentation for <postgres/> &gt;= 13.</p>

                <p>Since <postgres/> 13 recovery errors when the recovery target is not reached. The point-in-time recovery section now works for <postgres/> 13 and later as well as for earlier versions.</p>
            </release-item>
        </release-feature-list>

        <release-development-list>
            <release-item>
                <commit subject="Add new XML functions required for building documentation."/>
                <commit subject="Remove unused references to DocConfig and DocConfigData Perl modules."/>
                <commit subject="Allow documentation source file to be specified in manifest."/>
                <commit subject="Parse defaults and text sections in help.xml."/>
                <commit subject="Use CSS to number sections in documentation."/>
                <commit subject="Build command and configuration reference in C."/>
                <commit subject="Simplify section titles in configuration reference."/>
                <commit subject="Simplify description rendering in command and configuration reference."/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Build command and configuration reference in C.</p>
            </release-item>

            <release-item>
                <commit subject="Tidy and align site introduction and description."/>
                <commit subject="Remove old version conditionals from user guide."/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Update the site introduction and the user guide.</p>
            </release-item>

            <release-item>
                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Update Minio test/documentation container version.</p>
            </release-item>
        </release-development-list>
    </release-doc-list>

    <release-test-list>
        <release-improvement-list>
            <release-item>
                <github-issue id="2193"/>
                <github-pull-request id="2194"/>

                <release-item-contributor-list>
                    <release-item-ideator id="wu.ning"/>
                    <release-item-contributor id="reid.thompson"/>
                    <release-item-reviewer id="david.steele"/>
                </release-item-contributor-list>

                <p>Allow <id>config/load</id> unit test to run without <id>libssh2</id> installed.</p>
            </release-item>
        </release-improvement-list>

        <release-development-list>
            <release-item>
                <github-issue id="2228"/>

                <release-item-contributor-list>
                    <release-item-ideator id="georgy.shelkovy"/>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Remove unused fields from <code>backupJobResult()</code> test in command/backup unit.</p>
            </release-item>

            <release-item>
                <commit subject="Fix common/lock test failing with -Werror=unused-result.">
                    <github-pull-request id="2195"/>
                </commit>
                <commit subject="Adjust timeouts in the common/io/tls test to fix flapping coverage."/>
                <commit subject="Refactor of pq shim to allow more flexible scripting."/>
                <commit subject="Migrate backupFile() tests in command/backup module."/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                    <release-item-contributor id="reid.thompson"/>
                </release-item-contributor-list>

                <p>Improve unit tests.</p>
            </release-item>

            <release-item>
                <release-note version="2.50" subject="Skip files truncated during backup when bundling."/>

                <release-item-contributor-list>
                    <release-item-contributor id="david.steele"/>
                </release-item-contributor-list>

                <p>Add test to show behavior of bundled files truncated during backup.</p>
            </release-item>
        </release-development-list>
    </release-test-list>
</release>
