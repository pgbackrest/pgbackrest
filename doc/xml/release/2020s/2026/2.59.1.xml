            </release-item>
        </release-bug-list>

        <release-feature-list>
            <release-item>
                <release-item-contributor-list>
                    <release-item-contributor id="sebastien.lardiere"/>
                    <release-item-reviewer id="david.steele"/>
                </release-item-contributor-list>

                <p><proper>PostgreSQL 19beta3</proper> support.</p>
            </release-item>
        </release-feature-list>
    </release-core-list>

    <release-doc-list>
        <release-improvement-list>
            <release-item>
